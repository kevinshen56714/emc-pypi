(* EMC: Script *)

variables	= {
  input		-> $root+"lib/fcc_bonded",
  output	-> "dpd",

  // system definitions

  temperature	-> 1,
  density	-> 3.0,

  sigma		-> 1,
  epsilon	-> 1,
  cutoff	-> 1,
  
  // system dimensionalization

  lbead		-> (0.1391*density)^(1/3),	// nm
  dnano		-> 16,				// nm
  kappa		-> 0.5,				// chains/nm^2
  
  lbond		-> 0.7129703329*sigma,		// creates rho = 3.90212
  kbond		-> 4,
  lunit		-> sqrt(2)*lbond,
  
  // r1 represents the nanoparticle's outside perimeter
  // r2 represents the nanoparticle's inner core

  scale		-> (pi/2)**(1/3),		// conversion
  n		-> int(1.5*dnano/scale+1.5),	// based on vref = 0.1391 nm^3
  dnano		-> (2.0*n-1.0)/3.0*scale,	// original 1.5*dnano+0.5
  ngrafts	-> int(kappa*pi*dnano^2+0.5),
  l		-> n*lunit,
  r1		-> 1/2*l,
  r2		-> r1-0.5*lbond,

  // building parameters

  nrepeat	-> 961,
  ngraft	-> 191,
  npolymers	-> 3500,
  grace		-> 0.99,
  nrelax	-> 100,

  // random seed < 0 : uses tod
  
  seed		-> -1};

// get a crystal unit cell of a completely bonded fcc lattice

get		= {input};

// define an extra grafting site, used to connect polymers to

variables	= {
  lbond		-> 0};

sites		= {
  site		-> {id -> graft, name -> "grafting", mass -> 1},
  site		-> {id -> m, name -> "monomer", mass -> 1},
  site		-> {id -> t, name -> "terminator", mass -> 1},
  site		-> {id -> s, name -> "solvent", mass -> 1}};

simulation	= {
  units		-> {
    type	-> reduced,
    seed	-> seed},			// random seed
  constants	-> {
    systems	-> main},
  moves		-> {
    displace	-> {frequency -> 1, dmax -> 0.5*cutoff}
  },
  types		-> {
    merge	-> true,			// allow addition of new types
    skin	-> 0.0,
    virial	-> false,
    neighbor	-> sector,
    inverse	-> {nfunctions -> 50, cutoff -> 1e-4},
    coarse	-> {
      dpd	-> {
	active	-> true,
	data	-> {
	  {i0 -> fcc, i1 -> fcc, a -> 25, gamma -> 4.5, cutoff -> cutoff},
	  {i0 -> fcc, i1 -> graft, a -> 32.87, gamma -> 4.5, cutoff -> cutoff},
	  {i0 -> fcc, i1 -> m, a -> 32.88, gamma -> 4.5, cutoff -> cutoff},
	  {i0 -> fcc, i1 -> t, a -> 32.88, gamma -> 4.5, cutoff -> cutoff},
	  {i0 -> fcc, i1 -> s, a -> 32.88, gamma -> 4.5, cutoff -> cutoff},
	  {i0 -> graft, i1 -> graft, a -> 25, gamma -> 4.5, cutoff -> cutoff},
	  {i0 -> graft, i1 -> m, a -> 25.46, gamma -> 4.5, cutoff -> cutoff},
	  {i0 -> graft, i1 -> t, a -> 25.46, gamma -> 4.5, cutoff -> cutoff},
	  {i0 -> graft, i1 -> s, a -> 25.46, gamma -> 4.5, cutoff -> cutoff},
	  {i0 -> m, i1 -> m, a -> 25, gamma -> 4.5, cutoff -> cutoff},
	  {i0 -> m, i1 -> t, a -> 25, gamma -> 4.5, cutoff -> cutoff},
	  {i0 -> m, i1 -> s, a -> 25, gamma -> 4.5, cutoff -> cutoff},
	  {i0 -> t, i1 -> t, a -> 25, gamma -> 4.5, cutoff -> cutoff},
	  {i0 -> t, i1 -> s, a -> 25, gamma -> 4.5, cutoff -> cutoff},
	  {i0 -> s, i1 -> s, a -> 25, gamma -> 4.5, cutoff -> cutoff}
	}
      }
    },
    standard	-> {
      correct	-> {
	active	-> false},
      bond	-> {
	active	-> true,
	data	-> {				// kbond and lbond from input
	  {i0 -> fcc, i1 -> fcc, k -> kbond, l -> lbond},
	  {i0 -> fcc, i1 -> graft, k -> kbond, l -> lbond},
	  {i0 -> graft, i1 -> m, k -> kbond, l -> lbond},
	  {i0 -> m, i1 -> m, k -> kbond, l -> lbond},
	  {i0 -> m, i1 -> t, k -> kbond, l -> lbond}}},
      pair	-> {
	active	-> false}
    }
  }
};

// create a super crystal of a bonded fcc lattice

crystal		= {n -> {n, n, n}, periodic -> false}; 

// carve out a sphere by excluding a region with radius r1 during the
// carving process

carve		= {mode -> exclude, 
  inside	-> {shape -> spheroid, type -> absolute,
		     center -> {0, 0, 0}, radius -> {0, 0, 0}},
  outside	-> {shape -> spheroid, type -> absolute,
		     center -> {0, 0, 0}, radius -> {r1, r1, r1}}
};

// remove delete*100% of particles in the outer shell region r2<r<r1

carve		= {mode -> include, 
  nsites	-> ngrafts,
  inside	-> {shape -> spheroid, type -> absolute,
		     center -> {0, 0, 0}, radius -> {r2, r2, r2}},
  outside	-> {shape -> spheroid, type -> absolute,
		     center -> {0, 0, 0}, radius -> {r1, r1, r1}}
};

// retype the remaining particles in the outer shell region r2<r<r1

retype		= {source -> fcc, destination -> graft,
  inside	-> {shape -> spheroid, type -> absolute,
		      center -> {0, 0, 0}, radius -> {r2, r2, r2}},
  outside	-> {shape -> spheroid, type -> absolute,
		      center -> {0, 0, 0}, radius -> {r1, r1, r1}}
};

groups		= {
  group		-> {
    id		-> monomer,
    chemistry	-> "*m*",
    connects	-> {{0, {monomer, 0}}, {0, {terminator, 0}}}
  },
  group		-> {
    id		-> terminator,
    chemistry	-> "*t",
    connects	-> {{0, {monomer, 0}}}
  },
  group		-> {
    id		-> solvent,
    chemistry	-> "s"
  }
};

clusters	= {
  polymer	-> {
    id		-> graft,
    system	-> main,
    groups	-> {monomer},
    nrepeat	-> ngraft
  },
  graft		-> {
    core	-> fcc,
    type	-> graft,
    polymer	-> graft,
    connect	-> head
  }
};

put		= {name -> output+"_core"};
lammps		= {name -> output+"_core", mode -> put, forcefield -> dpd, types -> false};

clusters	= {
  (*
  cluster	-> {
    id		-> matrix,
    system	-> main,
    group	-> solvent,
    n		-> npolymers*(nrepeat+2)
  }
  *)
  polymer	-> {
    id		-> matrix,
    system	-> main,
    groups	-> {monomer},
    n		-> npolymers,
    nrepeat	-> nrepeat
  }
};

build		= {
  system	-> {
    id		-> main,
    density	-> density,
    temperature	-> temperature
  },
  select	-> {
    progress	-> list,
    frequency	-> 1,
    cluster	-> {graft, matrix},
    relax	-> {
      ncycles	-> nrelax,
      radius	-> cutoff},
    grow	-> {
      method	-> energetic,
      check	-> all,
      ntrials	-> 20,
      grace	-> {grace, grace},
      theta	-> 0,
      niterations -> 10000,
      exclude	-> {shape -> spheroid, type -> absolute,
		      center -> {0, 0, 0}, radius -> {r2, r2, r2}}
    }
  }
};

force		= {style -> none, message -> true};
force		= {style -> init, message -> true};

// equilibration phase

(*
pdb		= {output, forcefield -> standard, unwrap -> true};
lammps		= {output, mode -> put, forcefield -> dpd,
		   parameters -> true, types -> false};
run		= {ncycles -> 2000, nblocks -> 10};

force		= {style -> none, message -> true};
force		= {style -> init, message -> true};

put		= {output};
pdb		= {output, forcefield -> standard, unwrap -> true};

// sampling phase

traject		= {name -> output, frequency -> 1000,
		    append -> true, scale -> true, unwrap -> true};
restart		= {output, format -> "_%05ld", frequency -> 2000};

run		= {ncycles -> 10000, nblocks -> 10};

force		= {style -> none, message -> true};
force		= {style -> init, message -> true};
*)

// output the result in different formats; different extentions are implied

put		= {output, compress -> true};
pdb		= {output, forcefield -> standard, unwrap -> true, pbc -> 0};
lammps		= {output, mode -> put, forcefield -> dpd,
		   parameters -> true, types -> false};

