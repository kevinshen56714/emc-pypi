(* EMC: Script *)

variables	= {
  dir		-> $root+"field/",
  field		-> "compass",
  templates	-> dir+field+"/"+field+"_templates.dat",
  parameters	-> dir+field+"/"+field+".frc",
  output	-> "tryptophan",

  tbuild	-> 300,
  tequil	-> 1,
  nrelax	-> 200,
  nblocks	-> 100,
  ncycles	-> 5000,
  //density	-> 0.87650,
  //ntryptophan	-> 500

  density	-> 0.01,
  ntryptophan	-> 1
};

field		= {
  mode		-> cff,
  name		-> {parameters, templates},
  compress	-> false
};

groups		= {
  group		-> {
    id		-> tryptophan,
    depth	-> 6,
    chemistry	-> "c1ccc2c(c1)c(cn2H)C[C@@](C(=O)O)N"
  }
};

clusters	= {
  cluster	-> {
    id		-> tryptophan,
    system	-> main,
    n		-> ntryptophan,
    group	-> tryptophan
  }
};

field		= {mode -> apply};

simulation	= {
  units		-> {
    seed	-> 3
  },
  types 	-> {
    neighbor	-> thread,
    cff		-> {pair -> {coulomb -> cut, cutoff -> 5, mode -> repulsive}},
    coulomb 	-> {pair -> {active -> false}}
  }
};

put		= {"test"};

build		= {
  system	-> {
    id		-> main,
    temperature	-> tbuild,
    density	-> density
  },
  select	-> {
    progress	-> list,
    //order	-> sequence,
    frequency	-> 1,
    cluster	-> tryptophan,
    name	-> "error",
    relax	-> {ncycles -> nrelax, radius -> 9.5},
    grow	-> {
      method	-> energetic,
      grace	-> {0.999, 0.999},
      nbonded	-> 20,
      ntrials	-> 20,
      niterations -> 250
    }
  }
};

force		= {style -> none, message -> raw};
force		= {style -> init, message -> raw};

simulation	= {
  systems	-> {
    properties	-> {
      id	-> main, t -> tequil
    }
  }
};

run		= {nblocks -> nblocks, ncycles -> ncycles};

force		= {style -> none, message -> raw};
force		= {style -> init, message -> raw};

put		= {name -> output, compress -> false};
pdb		= {name -> output, forcefield -> cff, detect -> true, unwrap -> true};
lammps		= {name -> output, mode -> put, forcefield -> cff, parameters -> true};

