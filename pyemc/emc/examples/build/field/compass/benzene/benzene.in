atom_style	full
pair_style	lj/class2/coul/cut 9.5
pair_modify	tail yes
bond_style	class2
angle_style	class2
dihedral_style	class2
improper_style	class2
read_data	benzene.data
include		benzene.params
thermo		100
thermo_style	one
velocity	all create 300 27465 dist gaussian
fix		1 all nve/limit 0.1
fix		2 all langevin 300 300 100 76274
dump		1 all atom 100 benzene.dump
run		10000
write_restart	benzene.restart
