(* EMC: Script *)

variables	= {
  dir		-> $root+"field/",
  field		-> "compass",
  templates	-> dir+field+"/"+field+"_templates.dat",
  parameters	-> dir+field+"/"+field+".frc",
  output	-> "test",

  temperature	-> 300,
  density	-> 0.001,
  nmolecules	-> 1
};

field		= {
  mode		-> cff,
  name		-> {parameters, templates},
  compress	-> false
};

groups		= {
  group		-> {
    id		-> molecule,
    chemistry	-> "CCCCCCCC"
  }
};

clusters	= {
  cluster	-> {
    id		-> molecule,
    system	-> main,
    n		-> nmolecules,
    group	-> molecule
  }
};

field		= {mode -> apply};

simulation	= {
  units		-> {
    seed	-> 1234
  },
  types 	-> {
    neighbor	-> thread,
    cff		-> {pair -> {coulomb -> cut, cutoff -> 10, mode -> global}},
    coulomb 	-> {pair -> {active -> false}}
  }
};

build		= {
  system	-> {
    id		-> main,
    temperature	-> temperature,
    density	-> density
  },
  select	-> {
    progress	-> list,
    frequency	-> 1,
    cluster	-> molecule,
    relax	-> {ncycles -> 100, radius -> 5.0},
    name	-> "error",
    grow	-> {
      method	-> energetic,
      grace	-> {0.999, 0.999},
      nbonded	-> 20,
      ntrials	-> 20,
      niterations -> 250
    }
  }
};

force		= {style -> none, message -> nkt};
force		= {style -> none, message -> raw};
force		= {style -> init, message -> raw};

(*
run		= {ncycles -> 1000, nblocks -> 10};

force		= {style -> none, message -> raw};
force		= {style -> init, message -> raw};
*)

put		= {name -> output, compress -> false};
pdb		= {name -> output, forcefield -> cff, detect -> true, unwrap -> true};
lammps		= {name -> output, mode -> put, forcefield -> cff, parameters -> true};

