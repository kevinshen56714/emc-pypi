(* EMC: Script *)

variables	= {
  dir		-> $root+"field/",
  field		-> "pcff",
  templates	-> dir+field+"/"+field+"_templates.dat",
  parameters	-> dir+field+"/"+field+".frc",
  output	-> "benzene",

  temperature	-> 300,
  density	-> 0.87650,
  nbenzene	-> 50
};

field		= {
  mode		-> cff,
  name		-> {parameters, templates},
  compress	-> false
};

groups		= {
  group		-> {
    id		-> benzene,
    chemistry	-> "c1ccccc1"
  }
};

clusters	= {
  cluster	-> {
    id		-> benzene,
    system	-> main,
    n		-> nbenzene,
    group	-> benzene
  }
};

field		= {mode -> apply};

simulation	= {
  units		-> {
    seed	-> 1
  },
  types 	-> {
    neighbor	-> thread,
    cff		-> {pair -> {coulomb -> cut, cutoff -> 5, mode -> repulsive}},
    coulomb 	-> {pair -> {active -> false}}
  }
};

build		= {
  system	-> {
    id		-> main,
    temperature	-> temperature,
    density	-> density
  },
  select	-> {
    progress	-> list,
    //order	-> sequence,
    frequency	-> 1,
    cluster	-> benzene,
    name	-> "error",
    relax	-> {ncycles -> 100, radius -> 5.0},
    grow	-> {
      method	-> energetic,
      grace	-> {0.999, 0.999},
      nbonded	-> 20,
      ntrials	-> 20,
      niterations -> 250
    }
  }
};

force		= {style -> none, message -> raw};
force		= {style -> init, message -> raw};

//run		= {nblocks -> 10, ncycles -> 5000};

//force		= {style -> none, message -> raw};
//force		= {style -> init, message -> raw};

put		= {name -> output, compress -> false};
pdb		= {name -> output, forcefield -> cff, detect -> false, 
		   unwrap -> true};
lammps		= {name -> output, mode -> put, forcefield -> cff,
		   parameters -> true};

