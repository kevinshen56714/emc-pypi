(* EMC: Script *)

(* DPD simulation of n-mer polymers in a solvent at athermal conditions
   visual results can be viewed using 'vmd -e show_bond.vmd' *)

(* define variables *)

variables	= {

  (* system constants *)

  density	-> 3.0,
  temperature	-> 1.0,
  seed		-> 1,		(* random seed, uses date when < 0 *)

  (* definition of number of beads *)

  npolymers	-> 25,
  nrepeats	-> 20,
  nsolvents	-> npolymers*(nrepeats+2)*2,

  (* interaction parameters *)

  kij		-> 4,		(* bond interaction constant *)
  lij		-> 1,		(* bond length *)
  aij		-> 25,		(* DPD interaction parameter *)

  (* build parameters *)

  grace		-> 0.99,	(* grace allowence during build *)
  ncycles	-> 100,		(* relaxation steps during build *)
  drelax	-> 1.0,		(* relaxation cutoff diameter *)

  (* run and sampling parameters *)

  nrun		-> 1000,
  nblocks	-> 100,
  ntraject	-> 10,

  (* output target *)

  output	-> "bond"
};


(* Simulation description *)

(* define sites *)

sites		= {
  site		-> {id -> a, comment -> "middle bead", mass -> 1},
  site		-> {id -> t, comment -> "terminator bead", mass -> 1},
  site		-> {id -> s, comment -> "solvent bead", mass -> 1}
};

(* define groups *)

groups		= {
  group		-> {
    id		-> monomer1,
    chemistry	-> "a",
    branches	-> {0, 0},	(* degenerative branches:
				   can connect up and down *)
    connects	-> {
      {0, {monomer1, 0}},	(* defines connectivity:
				   bead 0 of group chemistry connects to
				   bead 0 of monomer1 chemistry *)
      {0, {terminator, 0}}	(* 
				   bead 0 of group chemistry connects to
				   bead 0 of terminator chemistry *)
    }
  },
  group		-> {
    id		-> terminator,
    chemistry	-> "t",
    branches	-> 0,		(* non-degenerative branching *)
    connects	-> {
      {0, {monomer1, 0}}	(* connects only to bead 0 of monomer1
				   chemistry *)
    }
  },
  group		-> {
    id		-> solvent,
    chemistry	-> "s"		(* solvent has no connectivity to other groups,
				   which therefore is ommited *)
  }
};

(* construct clusters using groups *)

clusters	= {
  polymer	-> {
    id		-> polymer,
    system	-> main,	(* target system; system id 'main' is created,
				   since it does not exist yet *)
    n		-> npolymers,	(* number of polymer clusters *)
    groups	-> {monomer1},	(* polymer consists of monomer1 only,
				   terminators are implied through group
				   connectivity definition *)
    type	-> alternate,
    nrepeat	-> nrepeat
  },
  cluster	-> {
    id		-> solvent,
    system	-> main,	(* target system *)
    n		-> nsolvent,	(* number of clusters *)
    group	-> solvent	(* use solvent group *)
  }
};

(* define bonded and nonbonded interactions;
   the simulation keyword allows for direct access to underlying memory 
   structures *)

simulation	= {
  units		-> {type -> reduced, seed -> seed},
  types		-> {
    merge	-> true,
    skin	-> 0.0,
    neighbor	-> sector,
    inverse	-> {active -> true, cutoff -> 1e-4, nfunctions -> 50},
    coarse	-> {
      dpd	-> {
	active	-> true,
	mix	-> berthelot,
	nbonded	-> 0,
	data	-> {
	  {i0 -> a, i1 -> a, a -> aij, gamma -> 4.5, cutoff -> 1},
	  {i0 -> t, i1 -> t, a -> aij, gamma -> 4.5, cutoff -> 1},
	  {i0 -> s, i1 -> s, a -> aij, gamma -> 4.5, cutoff -> 1}
	}
      }
    },
    standard	-> {
      correct	-> {active -> false},
      bond	-> {
	active	-> true,
	data	-> {
	  {i0 -> a, i1 -> a, k -> kij, l -> lij},
	  {i0 -> a, i1 -> t, k -> kij, l -> lij}
	}
      }
    }
  }
};

(* build clusters *)

build		= {
  system	-> {
    id		-> main,	(* define target system *)
    density	-> density,
    temperature	-> temperature
  },
  select	-> {
    progress	-> list,	(* can be a bar or a list *)
    frequency	-> 1,
    cluster	-> {polymer,
		    solvent},	(* include polymer and solvet cluster ids *)
    relax	-> {ncycles -> ncycles, radius -> drelax},
    grow	-> {
      method	-> energetic,	(* set method *)
      grace	-> {grace,
		    grace}	(* set initial insertion nonboned grace *)
    }
  }
};

(* display and calculate forces (latter for internal consistency check) *)

force		= {style -> none, message -> true};
force		= {style -> init, message -> true};

traject		= {name -> output, frequency -> ntraject,
		    append -> true, unwrap -> true, pbc -> true, scale -> true};

(* run a monte carlo simulation *)

run		= {ncycles -> nrun, nblocks -> nblocks};

(* display and calculate forces (latter for internal consistency check) *)

force		= {style -> none, message -> true};
force		= {style -> init, message -> true};

(* sample bond lengths *)

simulation	= {
  profiles	-> {
    frequency	-> 1,
    bond	-> {active -> true, nlevels -> 1, binsize -> 0.01}}
};

(* run a monte carlo simulation *)

run		= {ncycles -> nrun, nblocks -> nblocks};

(* display and calculate forces (latter for internal consistency check) *)

force		= {style -> none, message -> true};
force		= {style -> init, message -> true};

(* output results to various formats *)

put		= {name -> output, compress -> true, detail -> -1};
pdb		= {name -> output,
		    pbc -> true, unwrap -> true, forcefield -> standard};
lammps		= {name -> output, parameters -> true,
		    mode -> put, forcefield -> dpd, types -> false}

