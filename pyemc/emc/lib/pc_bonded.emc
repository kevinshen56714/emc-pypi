(* EMC: Enhanced Monte Carlo simulations *)

(*
    file:	pc_bonded.emc
    author:	Pieter J. in 't Veld
    date:	August 23, 2007
    purpose:	description of a single site primitive cubic crystalline
		unit cell with fully coordinated bonded neighbors
*)

identity = {
  name -> "pc_bonded"};

units = {
  type -> reduced};

variables = {
  pc_name -> "pc", pc_atomistic -> false, pc_chemistry -> "*[pc](*)(*)*",
  lbond -> 1, lcell -> lbond, la -> lcell, lb -> lcell, lc -> lcell,
  nsites -> 1, nclusters -> 1};

constants = {
  clusters -> pc,
  groups -> pc,
  sites -> pc};

types = {
  atomistic -> pc_atomistic,
  mass -> {n -> 1, data -> {
    id -> pc, name -> pc_name, reference -> 0, mass -> 1}}};

groups = {
  n -> 1, data -> {
    group -> pc, name -> pc_name, depth -> auto, chemistry -> pc_chemistry,
    terminator -> false, charges -> forcefield, charge -> 0, nsites -> 1, 
    sites -> {
      site -> 0, mass -> pc, charge -> 0, connects -> {branch, branch, branch, 
        branch, branch, branch}, bonds -> {any, any, any, any, any, any}}, 
    nbranches -> 1, branches -> {
      site -> 0, nconnects -> 1, connects -> {index -> pc, site -> 0}}}};

systems = {
  n -> 1, properties -> {
    id -> 0, p -> 0, v -> la*lb*lc, t -> 1, mass -> 1, 
    nsites -> 1, nclusters -> 1, 
    geometry -> {la, lb, lc, 0, 0, 0}}};

clusters = {
  n -> 1, data -> 
    {cluster -> 0, id -> pc, head -> 0, tail -> 0}};


sites = {
  n -> 1, data -> 
    {site -> 0, cluster -> 0, system -> 0, mass -> pc, flags -> 0b1100,
      group -> {0, 0}, connects -> {0, 0, 0, 0, 0, 0}, p -> {0, 0, 0},
      xtal -> {
	{-1, 0, 0}, {0, -1, 0}, {0, 0, -1}, {1, 0, 0}, {0, 1, 0}, {0, 0, 1}}}};

