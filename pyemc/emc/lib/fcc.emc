(* EMC: Enhanced Monte Carlo simulations *)

(*
    file:	fcc.emc
    author:	Pieter J. in 't Veld
    date:	August 23, 2007, July 7, 2016
    purpose:	description of a four site face-centered cubic crystalline
		unit cell
*)

identity = {
  name -> "fcc"};

units = {
  type -> reduced};

variables = {
  fcc_name -> "fcc", fcc_atomistic -> false, fcc_chemistry -> "[fcc]",
  lcell -> 2^(1/6)*sqrt(2), la -> lcell, lb -> lcell, lc -> lcell,
  nsites -> 4, nclusters -> 4};

constants = {
  clusters -> fcc,
  groups -> fcc,
  sites -> fcc};

types = {
  atomistic -> fcc_atomistic,
  mass -> {n -> 1, data -> {
    id -> 0, name -> fcc_name, reference -> 0, mass -> 1}}};

groups = {
  n -> 1, data -> {
    group -> 0, name -> fcc_name, chemistry -> fcc_chemistry,
    terminator -> false, nsites -> 1, sites -> {
      site -> 0, mass -> 0, charge -> 0}, nbranches -> 0}};

systems = {
  n -> 1, properties -> {
    id -> 0, p -> 0, v -> la*lb*lc, t -> 1, mass -> 1, 
    nsites -> 1, nclusters -> 1, 
    geometry -> {la, lb, lc, 0, 0, 0}}};

clusters = {
  n -> 4, data -> {
    {cluster -> 0, head -> 0, tail -> 0},
    {cluster -> 1, head -> 1, tail -> 1},
    {cluster -> 2, head -> 2, tail -> 2},
    {cluster -> 3, head -> 3, tail -> 3}}};

sites = {
  n -> 4, data -> {
    {site -> 0, cluster -> 0, system -> 0, mass -> 0, flags -> 0b1100,
      group -> {0, 0}, p -> {-la/4, -lb/4, -lc/4}, xtal -> {{0, 0, 0}}},
    {site -> 1, cluster -> 1, system -> 0, mass -> 0, flags -> 0b1100,
      group -> {0, 0}, p -> {la/4, lb/4, -lc/4}, xtal -> {{0, 0, 0}}},
    {site -> 2, cluster -> 2, system -> 0, mass -> 0, flags -> 0b1100,
      group -> {0, 0}, p -> {la/4, -lb/4, lc/4}, xtal -> {{0, 0, 0}}},
    {site -> 3, cluster -> 3, system -> 0, mass -> 0, flags -> 0b1100,
      group -> {0, 0}, p -> {-la/4, lb/4, lc/4}, xtal -> {{0, 0, 0}}}}};

