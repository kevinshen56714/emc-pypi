(* EMC: Enhanced Monte Carlo simulations *)

(*
    file:	diamond.emc
    author:	Pieter J. in 't Veld
    date:	July 9, 2015, July 7, 2016
    purpose:	description of an eight site diamond lattice, which consists
		of two interpenetrating face-centered cubic crystalline
		unit cells
*)

identity = {
  name -> "diamond"};

units = {
  type -> reduced};

variables = {
  diamond_name -> "diamond", 
  diamond_atomistic -> false, diamond_chemistry -> "[diamond]",
  lcell -> 2^(1/6)*4/sqrt(3), la -> lcell, lb -> lcell, lc -> lcell,
  nsites -> 8, nclusters -> 8};

constants = {
  clusters -> diamond,
  groups -> diamond,
  sites -> diamond};

types = {
  atomistic -> diamond_atomistic,
  mass -> {n -> 1, data -> {
    id -> 0, name -> diamond_name, reference -> 0, mass -> 1}}};

groups = {
  n -> 1, data -> {
    group -> 0, name -> diamond_name, chemistry -> diamond_chemistry,
    terminator -> false, nsites -> 1, sites -> {
      site -> 0, mass -> 0, charge -> 0}, nbranches -> 0}};

systems = {
  n -> 1, properties -> {
    id -> 0, p -> 0, v -> la*lb*lc, t -> 1, mass -> 1, 
    nsites -> 1, nclusters -> 1, 
    geometry -> {la, lb, lc, 0, 0, 0}}};

clusters = {
  n -> 8, data -> {
    {cluster -> 0, head -> 0, tail -> 0},
    {cluster -> 1, head -> 1, tail -> 1},
    {cluster -> 2, head -> 2, tail -> 2},
    {cluster -> 3, head -> 3, tail -> 3},
    {cluster -> 4, head -> 4, tail -> 4},
    {cluster -> 5, head -> 5, tail -> 5},
    {cluster -> 6, head -> 6, tail -> 6},
    {cluster -> 7, head -> 7, tail -> 7}}};

sites = {
  n -> 8, data -> {
    {site -> 0, cluster -> 0, system -> 0, mass -> 0, flags -> 0b1100,
      group -> {0, 0}, p -> {-la*3/8, -lb*3/8, -lc*3/8}, xtal -> {{0, 0, 0}}},
    {site -> 1, cluster -> 1, system -> 0, mass -> 0, flags -> 0b1100,
      group -> {0, 0}, p -> {la/8, lb/8, -lc*3/8}, xtal -> {{0, 0, 0}}},
    {site -> 2, cluster -> 2, system -> 0, mass -> 0, flags -> 0b1100,
      group -> {0, 0}, p -> {la/8, -lb*3/8, lc/8}, xtal -> {{0, 0, 0}}},
    {site -> 3, cluster -> 3, system -> 0, mass -> 0, flags -> 0b1100,
      group -> {0, 0}, p -> {-la*3/8, lb/8, lc/8}, xtal -> {{0, 0, 0}}},
    {site -> 4, cluster -> 4, system -> 0, mass -> 0, flags -> 0b1100,
      group -> {0, 0}, p -> {-la/8, -lb/8, -lc/8}, xtal -> {{0, 0, 0}}},
    {site -> 5, cluster -> 5, system -> 0, mass -> 0, flags -> 0b1100,
      group -> {0, 0}, p -> {la*3/8, lb*3/8, -lc/8}, xtal -> {{0, 0, 0}}},
    {site -> 6, cluster -> 6, system -> 0, mass -> 0, flags -> 0b1100,
      group -> {0, 0}, p -> {la*3/8, -lb/8, lc*3/8}, xtal -> {{0, 0, 0}}},
    {site -> 7, cluster -> 7, system -> 0, mass -> 0, flags -> 0b1100,
      group -> {0, 0}, p -> {-la/8, lb*3/8, lc*3/8}, xtal -> {{0, 0, 0}}}}};

