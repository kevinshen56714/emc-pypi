(* EMC: Enhanced Monte Carlo simulations *)

(*
    file:	pcc.emc
    author:	Pieter J. in 't Veld
    date:	August 23, 2007
    purpose:	description of a single site primitive cubic crystalline
		unit cell
*)

identity = {
  name -> "pc"};

unit = {
  type -> reduced};

variables = {
  lcell -> 2^(1/6), la -> lcell, lb -> lcell, lc -> lcell,
  nsites -> 1, nclusters -> 1};

constants = {
  clusters -> pc,
  groups -> pc,
  sites -> pc};

types = {
  mass -> {n -> 1, data -> {
    id -> pc, name -> "PC", reference -> 0, mass -> 1}}};

groups = {
  n -> 1, data -> {
    group -> pc, name -> "PC", terminator -> false, nsites -> 1, sites -> {
      site -> 0, mass -> 0, charge -> 0}, nbranches -> 0}};

systems = {
  n -> 1, properties -> {
    id -> pc, p -> 0, v -> la*lb*lc, t -> 1, mass -> 1, 
    nsites -> 1, nclusters -> 1, 
    geometry -> {la, lb, lc, 0, 0, 0}}};

clusters = {
  n -> 1, data -> 
    {cluster -> 0, head -> 0, tail -> 0}};

sites = {
  n -> 1, data -> 
    {site -> 0, cluster -> 0, system -> 0, mass -> pc, flags -> 0b1100,
      group -> {0, 0}, p -> {0, 0, 0}, xtal -> {{0, 0, 0}}}};

