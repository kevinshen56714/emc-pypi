#!/usr/bin/env emc.sh
(* EMC: Script *)

variables	= {
  input		-> $arg0,
  output	-> $arg1,
  traject	-> input,
  compress	-> true,
  unwrap	-> true,
  vdw		-> false,
  cut		-> false,
  source	-> ".",
  target	-> ".",
  frequency	-> 1
};

output		= {
  debug		-> false,
  exit		-> true,
  info		-> true,
  warning	-> true
};

shell		= {"rm -f "+output+(compress ? ".pdb.gz" : ".pdb")};
shell		= {"rm -f "+output+(compress ? ".psf.gz" : ".psf")};

get		= {name -> source+"/"+input};

sample		= {
  script	-> {
    id		-> -1,
    active	-> true,
    frequency	-> 1,
    quiet	-> true,
    script	-> {
      pdb 	-> {name -> output, compress -> compress, unwrap -> unwrap,
		    vdw -> vdw, mode -> append, cut -> cut}
    }
  }
};

traject		= {mode -> sample, name -> traject, frequency -> frequency};

